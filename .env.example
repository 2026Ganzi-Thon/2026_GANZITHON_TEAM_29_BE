# Public client configuration. These values may be used by the separate frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local CLI environment selection. Do not add SUPABASE_YES here.
SUPABASE_ENV=development

# Hosted-project credentials are secrets. Keep real values only in local ignored
# files or protected CI environment secrets, and never expose them to a client.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=
